---
import '../styles/global.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import plexSemi from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import plexRegular from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationJsonLd, serializeJsonLd, websiteJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  imageAlt?: string;
  robots?: string;
}

const { title, description, imageAlt = site.imageAlt, robots } = Astro.props;
const documentTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const origin = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL('/og.png', origin).href;
const graphs = [organizationJsonLd(), websiteJsonLd()];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#101418" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={plexSemi} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={plexRegular} as="font" type="font/woff2" crossorigin="anonymous" />
    <Analytics />
    <SpeedInsights />
    <Fragment
      set:html={graphs
        .map((graph) => `<script type="application/ld+json">${serializeJsonLd(graph)}</script>`)
        .join('')}
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { bindClickTracking } from '../scripts/track-clicks';
      bindClickTracking();
    </script>
  </body>
</html>
