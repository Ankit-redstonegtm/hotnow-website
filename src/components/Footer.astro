---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <Logo />
      <p class="domain"><a href="/">{site.domain}</a></p>
    </div>
    <nav aria-label="Footer">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-contact">
      <p class="field-label">Get started</p>
      <a
        href="#start"
        data-track="Start trial"
        data-track-location="footer"
      >
        Get started
      </a>
      <a href={site.loginUrl} data-track="Log in" data-track-location="footer">Log in</a>
      {
        site.email && (
          <a href={`mailto:${site.email}`}>{site.email}</a>
        )
      }
    </div>
  </div>
</footer>
