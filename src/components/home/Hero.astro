---
import CtaLink from '../CtaLink.astro';
import LeadCard from './LeadCard.astro';
import { site } from '../../data/site';
import { bookingNote, hero, heroLead, setupNote, trialCta } from '../../data/home';
---

<section class="section hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>
        {hero.titleLines.map((line, index) => <span class={index === 1 ? 'grad' : undefined}>{line}</span>)}
      </h1>
      <p class="sub">{hero.sub}</p>
      <p class="body">{hero.body}</p>
      <p class="body">{hero.detail}</p>
      <div class="actions">
        <CtaLink href={site.bookingUrl} label={trialCta} track="Start trial" location="hero" />
        <p class="support">{setupNote}</p>
        <p class="support">{bookingNote}</p>
      </div>
    </div>
    <div class="frame">
      <div class="frame-top">
        <div>
          <p class="frame-kicker">{site.name}</p>
          <p class="frame-title">{hero.frameTitle}</p>
          <p class="frame-count">{hero.frameCount}</p>
        </div>
      </div>
      <p class="frame-context">{hero.frameContext}</p>
      <LeadCard lead={heroLead} />
      <p class="frame-foot">{hero.frameFoot}</p>
    </div>
  </div>
</section>
