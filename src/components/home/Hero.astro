---
import DomainCta from '../DomainCta.astro';
import { site } from '../../data/site';
import { bookingNote, hero, setupNote, trialCta } from '../../data/home';
---

<section class="section hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>
        {hero.titleLines.map((line, index) => <span class={index === 1 ? 'grad' : undefined}>{line}</span>)}
      </h1>
      <p class="sub">{hero.sub}</p>
      <p class="body">{hero.body}</p>
      <p class="body">{hero.detail}</p>
      <p class="morning">{hero.morning}</p>
      <div class="actions">
        <DomainCta action={site.bookingUrl} label={trialCta} location="hero" />
        <p class="support">{setupNote}</p>
        <p class="support">{bookingNote}</p>
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-video">
        <video
          autoplay
          muted
          loop
          playsinline
          controls
          preload="auto"
          poster="/hotnow-vsl-poster.jpg"
          width="1920"
          height="1080"
          aria-label="HotNow"
        >
          <source src="/hotnow-vsl.mp4" type="video/mp4" />
        </video>
      </div>
      <button type="button" class="sound-toggle" aria-pressed="false">
        <svg class="sound-icon sound-icon-off" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M2.2 6h2.1L7.6 3.4v9.2L4.3 10H2.2A.8.8 0 0 1 1.4 9.2V6.8A.8.8 0 0 1 2.2 6z"
          />
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            d="M10.2 6.4 13.4 9.6M13.4 6.4 10.2 9.6"
          />
        </svg>
        <svg class="sound-icon sound-icon-on" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M2.2 6h2.1L7.6 3.4v9.2L4.3 10H2.2A.8.8 0 0 1 1.4 9.2V6.8A.8.8 0 0 1 2.2 6z"
          />
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            d="M10 6.1a2.6 2.6 0 0 1 0 3.8M11.7 4.6a4.6 4.6 0 0 1 0 6.8"
          />
        </svg>
        <span>Tap for sound</span>
      </button>
    </div>
  </div>
</section>

<script>
  const media = document.querySelector('.hero-media');
  const video = media?.querySelector('video');
  const button = media?.querySelector('.sound-toggle');
  const label = button?.querySelector('span');

  if (video instanceof HTMLVideoElement && button instanceof HTMLButtonElement && label) {
    const paint = () => {
      const on = !video.muted;
      label.textContent = on ? 'Mute' : 'Tap for sound';
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
    };

    button.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        video.currentTime = 0;
        video.play().catch(() => {});
      } else {
        video.muted = true;
      }
      paint();
    });
  }
</script>
