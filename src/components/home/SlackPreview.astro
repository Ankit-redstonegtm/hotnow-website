---
import ChannelIcon from './ChannelIcon.astro';
import { heroLead, leads } from '../../data/home';

const others = leads.slice(1);
const champion = heroLead.contacts[0];
---

<div class="slack">
  <div class="slack-bar">
    <ChannelIcon id="slack" />
    <span>Slack</span>
  </div>
  <div class="slack-msg">
    <span class="slack-avatar" aria-hidden="true">H</span>
    <div>
      <p class="slack-meta">
        <strong>HotNow</strong>
        <span class="slack-app">APP</span>
        <span class="slack-time">9:00 AM</span>
      </p>
      <p class="slack-lead-in">Your 10 hot leads are ready.</p>
      <div class="slack-card">
        <p class="slack-company">
          {heroLead.company}
          <span>{heroLead.segment}</span>
        </p>
        <p class="slack-person">
          {champion.priority}
          {champion.badge ? ` · ${champion.badge}` : ''}: {champion.name}, {champion.title}
        </p>
        <p class="slack-mobile">Mobile {champion.mobile}</p>
        <ul>
          {heroLead.evidence.map((line) => <li>{line}</li>)}
        </ul>
        <p class="slack-tie">{heroLead.tie}</p>
      </div>
      <ol class="slack-more">
        {
          others.map((lead) => (
            <li>
              <strong>{lead.company}.</strong> {lead.evidence[0]}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>
