---
import { outcomes } from '../../data/home';
---

<section class="section" aria-labelledby="outcomes-title">
  <div class="wrap">
    <div class="section-copy">
      <h2 id="outcomes-title">{outcomes.heading}</h2>
      <p>{outcomes.intro}</p>
    </div>
    <ol class="outcome-grid">
      {
        outcomes.items.map((item, index) => (
          <li>
            <p class="outcome-index">{String(index + 1).padStart(2, '0')}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="closer">{outcomes.closer}</p>
  </div>
</section>
