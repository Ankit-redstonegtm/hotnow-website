---
import { faq } from '../../data/home';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-copy">
      <h2 id="faq-title">{faq.heading}</h2>
    </div>
    <div class="faq">
      {
        faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
