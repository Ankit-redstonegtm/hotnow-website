---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Watches from '../components/home/Watches.astro';
import Method from '../components/home/Method.astro';
import Timing from '../components/home/Timing.astro';
import Product from '../components/home/Product.astro';
import Delivery from '../components/home/Delivery.astro';
import Comparison from '../components/home/Comparison.astro';
import Pricing from '../components/home/Pricing.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { site } from '../data/site';
---

<Base title={site.title} description={site.description} imageAlt={site.imageAlt}>
  <Hero />
  <HowItWorks />
  <Watches />
  <Method />
  <Timing />
  <Product />
  <Delivery />
  <Comparison />
  <Pricing />
  <Faq />
  <FinalCta />
</Base>
