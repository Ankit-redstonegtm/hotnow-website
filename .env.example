# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# No trailing slash. Rebuild after changing it.
PUBLIC_SITE_URL=https://hotnow.co

# The self-serve app origin. Every primary CTA sends people to <PUBLIC_APP_URL>/signup,
# and "Log in" to <PUBLIC_APP_URL>/login. No trailing slash. Rebuild after changing.
PUBLIC_APP_URL=https://app.hotnow.co
